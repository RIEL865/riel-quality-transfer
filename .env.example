# From your TikTok Developer app > Credentials
TIKTOK_CLIENT_KEY=replace_with_client_key
TIKTOK_CLIENT_SECRET=replace_with_client_secret

# Must exactly match the Redirect URI registered under Login Kit > Web.
# After deploying to Vercel, use:
# https://YOUR-VERCEL-DOMAIN/api/tiktok/callback
TIKTOK_REDIRECT_URI=https://YOUR-VERCEL-DOMAIN/api/tiktok/callback

# Long random secret used to encrypt the short-lived browser session cookie.
SESSION_SECRET=replace_with_a_long_random_secret
